    50  A002F  6EFB                     	jnz 	main
    51  A0031  D900                  Q  	mov.w 	#0,r0 		; reinicia cuenta (cada segundo)
    52  A0033  7EAF201F                 	bnot 	P2_0 		; cambia la polaridad del diodo
    53  A0037  FEF3                  B  	jmp 	main
