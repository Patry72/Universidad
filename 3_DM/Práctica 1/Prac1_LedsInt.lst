    40  A0017  C7809603              S  	mov.b 	#80h,TA0MR 	; TA0 en modo temporizador con f32
    41  A001B  C7015500              S  	mov.b 	#1,TA0IC 	; Limpia el bit de petición de interrupción. Prioridad 1
    42  A001F  75CF8603CA08             	mov.w 	#2250,TA0 	; 2250 periodos de 27,7ns*32= 2 ms. (reloj 36MHz)
    43  A0025  7E9F001C                 	bset 	TA0S 		; arranca el contador
    44  A0029  D900                  Q  	mov.w 	#0,r0 		; r0 cuenta de periodos de 2 ms.
