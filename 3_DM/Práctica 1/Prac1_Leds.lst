    26                                  ;
    27                                  	.section prog, code
    28  A0000                           	.org VprogTOP
    29                                  ;
    30                                  ;----- Limpieza de la RAM -------------------------------
    31                                  ;
    32  A0000  D900                  Q  	mov.w #0, R0 ; 0 clear
    33  A0002  75C3803C                 	mov.w #(VramEND+1-VramTOP)/2,R3 ; number of times
    34  A0006  AA0004                S  	mov.w #VramTOP, A1 ; start address
    35  A0009  7DEA                     	sstr.w
