    10                                  ;----- DEFINICIÓN DE SÍMBOLOS 3DKUM16C/62PU ---------------------------------------------
    11                                  ;
    12  00000400h                       VramTOP		.equ 000400h  ; Inicio de la RAM interna
    13  00007CFFh                       VramEND 	.equ 007CFFh  ; Final de la RAM interna
    14  00007CFFh                       VIstack		.equ 007CFFh  ; Direccion de la cima de la pila stack pointer
    15  000A0000h                       VprogTOP	.equ 0A0000h  ; Inicio del area de programa
    16  000FA000h                       Vintbase 	.equ 0FA000h  ; Inicio tabla de interrupciones variable
    17  000FFFDCh                       Vvector 	.equ 0FFFDCh  ; Inicio tabla de interrupciones fija
