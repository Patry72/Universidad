    37                                  ;----- INICIALIZACIÓN INTERRUPCIÓN Y PUERTOS 3DKUM16C/62PU ------------------------------
    38                                  ;
    39  A000B                           reset: 
    40  A000B  7E9F301F                 	bset PD2_0 			; Activamos puerto P2_0
    41  A000F  C7809603              S  	mov.b #80h,TA0MR 	; Ponemos TA0 en modo temporizador con reloj f32
    42  A0013  75CF8603CA08             	mov.w #2250,TA0 	; Inicializa valor de cuenta del temporizador -> 2250 periodos de 27,77 ns x 32= 2 ms (reloj de 36MHz)
    43  A0019  7E9F001C                 	bset TA0S 			; Inicia el contador
    44                                  ;
    45                                  ;----- PROGRAMA PRINCIPAL ---------------------------------------------------------------
    46                                  ;
    47  A001D                           main:
    48  A001D  D900                  Q  	mov.w #0,r0 	; Inicializamos r0 (cuenta de periodos de 2 ms)
    49  A001F                           retraso:
    50  A001F  7E0FAB02                 	btstc 3,TA0IC 	; Comprobamos la interrupción de fin de cuenta del temporizador (bit 3) 
    51  A0023  6CFB                     	jnc retraso		; Salta a RETRASO si el bit testeado es 0
    52  A0025  C910                  Q  	add.w #1,r0 	; r0 = r0 + 1
    53  A0027  7780F401                 	cmp.w #500,r0 	; Compara si r0 = 500 (500 - r0)
    54  A002B  6EF3                     	jnz retraso		; Salta a RETRASO si el testeo anterior aún no es 0
    55  A002D  7EAF201F                 	bnot P2_0 		; Cambia la polaridad del diodo
    56  A0031  FEEB                  B  	jmp main		; Salta a MAIN
