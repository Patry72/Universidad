    37                                  ;----- INICIALIZACIÓN INTERRUPCIÓN Y PUERTOS 3DKUM16C/62PU ------------------------------
    38                                  ;
    39  A000B                           reset: 
    40  A000B  7E9F301F                 	bset PD2_0 			; Activamos puerto P2_0
    41  A000F  C7809603              S  	mov.b #80h,TA0MR 	; Ponemos TA0 en modo temporizador con reloj f32
    42  A0013  C7809703              S  	mov.b #80h,TA1MR	; Ponemos TA1 en modo temporizador con reloj f32
    43  A0017  75CF8603CA08             	mov.w #2250,TA0 	; Inicializa valor de cuenta del temporizador -> 2250 periodos de 27,77 ns x 32 = 2 ms (reloj de 36MHz)
    44  A001D  75CF8803CA08             	mov.w #2250,TA1		; Inicializa valor de cuenta del temporizador -> 2250 periodos de 27,77 ns x 32 = 2 ms (reloj de 36MHz)
    45  A0023  7E9F001C                 	bset TA0S 			; Inicia el primer contador
    46  A0027  7E9F011C                 	bset TA1S
    47                                  ;
    48                                  ;----- PROGRAMA PRINCIPAL ---------------------------------------------------------------
    49                                  ;
    50  A002B                           main:
    51                                  	
    52  A002B  D900                  Q  	mov.w #0,r0 	; Inicializamos r0 contador de TA0 (cuenta de periodos de 2 ms)
    53  A002D  D901                  Q  	mov.w #0,r1 	; Inicializamos r1 contador de TA1 (cuenta de periodos de 2 ms)
    54                                  	
    55  A002F                           retrasoOFF:
    56  A002F  7E0FAB02                 	btstc 3,TA0IC 	; Comprobamos la interrupción de fin de cuenta del temporizador (bit 3) 
    57  A0033  6C0F                     	jnc retrasoON	; Salta a encender led si el bit testeado es 0
    58  A0035  C910                  Q  	add.w #1,r0 	; r0 = r0 + 1
    59  A0037  7780DC05                 	cmp.w #1500,r0 	; Compara si r0 = 1500 (1500 - r0)
    60  A003B  6EF3                     	jnz retrasoOFF	; Veulve al bucle si el testeo anterior aún no es 0
    61  A003D  7EAF201F                 	bnot P2_0 		; Cambia la polaridad del diodo
