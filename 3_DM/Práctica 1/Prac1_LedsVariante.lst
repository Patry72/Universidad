    14  00007CFFh                       VIstack		.equ 007CFFh  ; Direccion de la cima de la pila stack pointer
    15  000A0000h                       VprogTOP	.equ 0A0000h  ; Inicio del area de programa
    16  000FA000h                       Vintbase 	.equ 0FA000h  ; Inicio tabla de interrupciones variable
