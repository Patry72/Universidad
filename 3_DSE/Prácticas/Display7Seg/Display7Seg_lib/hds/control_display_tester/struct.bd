text (MLText
uid 246,0
va (VaSet
isHidden 1
)
xt "39200,33200,56400,37200"
st "
-- eb1 1                                        
PROCESS
FILE fichero : TEXT OPEN read_mode IS \"C:\\DisSistEmpotrados\\Display7Seg\\vectores.txt\" ;
VARIABLE linea : line;
VARIABLE drst : std_logic;
VARIABLE ddig0 , ddig1, ddig2, ddig3 : std_logic_vector(3 downto 0);
VARIABLE ch : character;
VARIABLE p_clk : time := 10 ns;
BEGIN
-- Leemos la primera linea del fichero con las cabeceras
IF NOT ENDFILE (fichero) THEN
READLINE(fichero, linea) ;
END IF;
WHILE NOT ENDFILE(fichero) LOOP
-- Leemos una linea del fichero
READLINE(fichero, linea) ;
-- Sacamos los datos que van precedidos de un tabulador
READ(linea, ch) ; lee_bit(linea, drst) ;
READ(linea, ch) ; lee_vector(linea, ddig3) ;
READ(linea, ch) ; lee_vector(linea, ddig2) ;
READ(linea, ch) ; lee_vector(linea, ddig1) ;
READ(linea, ch) ; lee_vector(linea, ddig0) ;
-- Aplicamos el vector de test
dig0 <= ddig0;
dig1 <= ddig1;
dig2 <= ddig2;
dig3 <= ddig3;
rst <= drst;
-- Aplicamos 10 pulsos de reloj
FOR I IN 1 TO 1 LOOP
clk <= '0';
WAIT FOR p_clk/2;
clk <= '1';
WAIT FOR p_clk/2;
END LOOP;
-- Para sistemas asincronos bastaría esperar el tiempo de cambio de datos
-- WAIT FOR 100 ns ;
END LOOP;
-- Condición de fin de proceso
WAIT;
END PROCESS;




"
tm "HdlTextMgr"
wrapOption 3
visibleHeight 4600
visibleWidth 17600
)
)
)
