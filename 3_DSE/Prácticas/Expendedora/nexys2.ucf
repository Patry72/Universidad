# Fichero UCF para Nexys2
# clk -> Reloj externo de entrada de 50 MHz por PIN B8
NET "clk" LOC = "B8";

# Imponemos a la linea de reloj una restriccion de 50000 KHz = 50 MHz
NET "clk" TNM_NET = sys_clk_pin;
TIMESPEC TS_sys_clk_pin = PERIOD sys_clk_pin 50000 kHz;

#Botones
NET "rst" LOC = "B18";
NET "m5" LOC = "E18";
NET "m10" LOC = "D18";

#LED
NET "d" LOC = "J14";
NET "ep" LOC = "J15";
