[ModelSim]
auxiliar_lib = $HDS_PROJECT_DIR\auxiliar_lib\work
Conversor_lib = $HDS_PROJECT_DIR\Conversor_lib\work
vectores = $HDS_HOME\hdl_libs\vectores\work
[hdl]
auxiliar_lib = $HDS_PROJECT_DIR/auxiliar_lib/hdl
Conversor_lib = $HDS_PROJECT_DIR/Conversor_lib/hdl
[hds]
auxiliar_lib = $HDS_PROJECT_DIR/auxiliar_lib/hds
Conversor_lib = $HDS_PROJECT_DIR/Conversor_lib/hds
[hds_settings]
default_library = Conversor_lib
version = 2
[library_files_inclusion]
auxiliar_lib = all
[library_type]
auxiliar_lib = regular
Conversor_lib = regular
[shared]
others = $HDS_TEAM_HOME/shared.hdp
