[DesignChecker]
Multiplicador_lib = $HDS_PROJECT_DIR/Multiplicador_lib/designcheck
[ModelSim]
auxiliar_lib = $HDS_PROJECT_DIR\auxiliar_lib\work
Multiplicador_lib = $HDS_PROJECT_DIR\Multiplicador_lib\work
vectores = $HDS_HOME\hdl_libs\vectores\work
[hdl]
auxiliar_lib = $HDS_PROJECT_DIR/auxiliar_lib/hdl
Multiplicador_lib = $HDS_PROJECT_DIR/Multiplicador_lib/hdl
[hds]
auxiliar_lib = $HDS_PROJECT_DIR/auxiliar_lib/hds
Multiplicador_lib = $HDS_PROJECT_DIR/Multiplicador_lib/hds
[hds_settings]
default_library = Multiplicador_lib
version = 2
[library_files_inclusion]
auxiliar_lib = all
[library_type]
auxiliar_lib = regular
Multiplicador_lib = regular
[shared]
others = $HDS_TEAM_HOME/shared.hdp
